server {
    listen 80;
    listen [::]:80;
    server_name n0thing.works www.n0thing.works;
    return 301 https://n0thing.works$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name n0thing.works;

    root /var/www/n0thing.works;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/n0thing.works/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/n0thing.works/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.n0thing.works;

    ssl_certificate /etc/letsencrypt/live/n0thing.works/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/n0thing.works/privkey.pem;
    return 301 https://n0thing.works$request_uri;
}
